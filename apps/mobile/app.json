{
  "expo": {
    "name": "Sweaty",
    "slug": "sweaty",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sweaty",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ogig.sweaty",
      "appleTeamId": "X6TS5L9ZTL",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "Allow Sweaty to read your workout data from Apple Health.",
        "NSHealthUpdateUsageDescription": "Allow Sweaty to save your completed workouts to Apple Health."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ogig.sweaty"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-notifications",
      "@bacons/apple-targets",
      "./plugins/with-ios-object-version.cjs",
      "./plugins/with-live-activities-plist.cjs",
      "./plugins/with-app-group.cjs",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-localization",
      [
        "react-native-health",
        {
          "isClinicalDataEnabled": false,
          "healthSharePermission": "Allow Sweaty to read your workout data from Apple Health.",
          "healthUpdatePermission": "Allow Sweaty to save your completed workouts to Apple Health."
        }
      ],
      "react-native-health-connect",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3d62df88-5973-4504-9c6f-0f2393a5bd6d",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.ogig.sweaty.SweatyWidget",
                  "targetName": "SweatyWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.ogig.sweaty"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "ogig"
  }
}
