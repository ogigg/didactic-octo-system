# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google OAuth Configuration
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id

# OpenRouter AI API Key
OPENROUTER_API_KEY=your_openrouter_api_key

# PostHog Analytics Configuration
# Get your API key from https://app.posthog.com/project/settings
# Use a separate PostHog project for preview builds. Local development is
# isolated and does not capture unless EXPO_PUBLIC_POSTHOG_ENABLE_LOCAL=true.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_POSTHOG_KEY=your_posthog_project_api_key
# Use https://eu.i.posthog.com for EU projects or https://us.i.posthog.com for US.
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
EXPO_PUBLIC_POSTHOG_ENABLE_LOCAL=false

# Supabase Service Key (for seed scripts only - never commit real values)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key
