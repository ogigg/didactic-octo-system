# Copy to fastlane/.env (git-ignored) and fill in real values.
#
# fastlane loads .env files from this directory. Keeping this example here also
# stops fastlane from loading apps/mobile/.env (development app config) into
# release builds.

# App Store Connect API key. Save the downloaded .p8 as
# fastlane/AuthKey_<ASC_KEY_ID>.p8 (git-ignored), or point ASC_KEY_PATH at it.
#
# Use a team key (Users and Access -> Integrations -> App Store Connect API ->
# Team Keys) and set ASC_KEY_ID and ASC_ISSUER_ID. The lanes use it to fetch
# the signing assets with match (read-only), read build numbers and upload. An
# individual key (ASC_KEY_ID only) may be refused access to certificates and
# profiles.
ASC_KEY_ID=
ASC_ISSUER_ID=
# Optional. Relative paths resolve from apps/mobile.
ASC_KEY_PATH=

# Encryption passphrase of the private match repo that holds the team's one
# shared distribution certificate and App Store profiles (see fastlane/Matchfile
# and README -> "iOS signing"). Copy it from the "Sweaty – iOS signing" item in
# the team password manager, then uncomment the line. It stays commented here
# because match treats a blank value as a real passphrase.
# MATCH_PASSWORD=

# --- Android / Google Play ---------------------------------------------------

# Google Play service account JSON key (Play Console -> Users and permissions,
# release permissions for Sweaty). Defaults to
# fastlane/google-play-service-account.json; fastlane/*.json is git-ignored.
PLAY_JSON_KEY_PATH=
# Status of the internal testing release fastlane creates. Play only accepts
# "draft" until the app has its first release; switch to "completed" after the
# first internal release is rolled out by hand in Play Console.
PLAY_RELEASE_STATUS=draft

# Upload key. Prefer fastlane/keystore.properties (see
# keystore.properties.example); these env vars override it, e.g. on CI.
# Relative store file paths resolve from apps/mobile/fastlane/.
SWEATY_UPLOAD_STORE_FILE=
SWEATY_UPLOAD_STORE_PASSWORD=
SWEATY_UPLOAD_KEY_ALIAS=
SWEATY_UPLOAD_KEY_PASSWORD=
