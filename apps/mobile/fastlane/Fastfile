# Release lanes for the Sweaty Expo app. They build locally and upload
# straight to the stores, with no EAS involved.
#
# Run from apps/mobile, e.g. `npm run release:ios` or
# `bundle exec fastlane ios build`. Setup, credentials and troubleshooting:
# apps/mobile/README.md -> "Releasing with fastlane".

require "dotenv"
require "json"
require "open3"
require "shellwords"
require "uri"

# fastlane's log handling and CocoaPods both break without a UTF-8 locale.
# Ruby picks its default encoding at startup, so set it here as well as the
# environment inherited by child processes.
%w[LANG LC_ALL].each do |name|
  ENV[name] = "en_US.UTF-8" unless ENV[name].to_s.include?("UTF-8")
end
Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8

# `xcodebuild -showBuildSettings` on this workspace takes longer than
# fastlane's default 3-second timeout.
ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] ||= "30"

FASTLANE_DIR = File.expand_path(__dir__)
APP_ROOT = File.expand_path("..", FASTLANE_DIR)
BUILD_DIR = File.join(APP_ROOT, "build")

IOS_DIR = File.join(APP_ROOT, "ios")
IOS_WORKSPACE = File.join(IOS_DIR, "Sweaty.xcworkspace")
IOS_SCHEME = "Sweaty"
IOS_TEAM_ID = "X6TS5L9ZTL"

# Stamp written into a generated native folder after a successful prebuild.
FINGERPRINT_STAMP = ".fastlane-fingerprint"

# Files `expo export:embed` reads for a release JS bundle, lowest priority
# first. Values already in the process environment win over all of them.
EXPO_RELEASE_ENV_FILES = %w[.env .env.production .env.local .env.production.local].freeze

default_platform(:ios)
skip_docs

before_all do
  ensure_bundle_exec
end

# --- Shared helpers ---------------------------------------------------------

# Hash of everything that shapes the generated native project: app config,
# config plugins, native dependencies and the Apple target configs. ios/ and
# android/ are git-ignored (generated), so they are not part of it.
def native_fingerprint(platform)
  script = <<~JS
    require("@expo/fingerprint")
      .createFingerprintAsync(process.cwd(), { platforms: [process.argv[1]] })
      .then((fingerprint) => console.log(fingerprint.hash))
      .catch((error) => { console.error(error); process.exit(1); });
  JS
  stdout, stderr, status = Open3.capture3("node", "-e", script, platform.to_s, chdir: APP_ROOT)
  UI.user_error!("Could not compute the native fingerprint:\n#{stderr}") unless status.success?
  stdout.strip
end

# Runs `expo prebuild` only when the native project is missing, its inputs
# changed since the last prebuild, or `clean` is set. Prebuild always uses
# --clean: incremental prebuilds crash in @bacons/apple-targets, and a fresh
# folder drops any local edits to generated files.
def prepare_native_project(platform, clean: false, required_paths: [])
  native_dir = File.join(APP_ROOT, platform.to_s)
  stamp = File.join(native_dir, FINGERPRINT_STAMP)
  fingerprint = native_fingerprint(platform)
  complete = required_paths.all? { |path| File.exist?(File.join(native_dir, path)) }

  if !clean && complete && File.exist?(stamp) && File.read(stamp).strip == fingerprint
    UI.success("#{platform}/ is up to date (fingerprint #{fingerprint[0, 12]}), skipping expo prebuild")
    return
  end

  UI.message("Regenerating #{platform}/ with expo prebuild (fingerprint #{fingerprint[0, 12]})")
  Dir.chdir(APP_ROOT) do
    # CI=1 stops prebuild from prompting about uncommitted changes.
    sh({ "CI" => "1", "EXPO_NO_GIT_STATUS" => "1" },
       "npx", "expo", "prebuild", "--platform", platform.to_s, "--clean", "--no-install")
  end
  yield if block_given?
  File.write(stamp, "#{fingerprint}\n")
end

# Fails before a long native build when the JS bundle would ship without the
# config lib/supabase.ts requires at startup. EAS used to inject these values;
# locally they come from apps/mobile/.env.production.local (git-ignored).
def check_release_js_env!
  env_files = EXPO_RELEASE_ENV_FILES.map { |name| File.join(APP_ROOT, name) }.select { |path| File.exist?(path) }
  env = Dotenv.parse(*env_files).merge(ENV.to_h)

  url = env["EXPO_PUBLIC_SUPABASE_URL"].to_s.strip
  anon_key = env["EXPO_PUBLIC_SUPABASE_ANON_KEY"].to_s.strip
  host = begin
    URI.parse(url).host.to_s
  rescue URI::InvalidURIError
    ""
  end

  errors = []
  errors << "EXPO_PUBLIC_SUPABASE_URL is missing" if url.empty?
  errors << "EXPO_PUBLIC_SUPABASE_URL must use https://" unless url.empty? || url.start_with?("https://")
  errors << "EXPO_PUBLIC_SUPABASE_URL points at a local server" if %w[localhost 127.0.0.1].include?(host)
  errors << "EXPO_PUBLIC_SUPABASE_URL is still the .env.example placeholder" if url.include?("your-project-ref")
  errors << "EXPO_PUBLIC_SUPABASE_ANON_KEY is missing" if anon_key.empty?
  errors << "EXPO_PUBLIC_SUPABASE_ANON_KEY is still the .env.example placeholder" if anon_key.start_with?("your_")
  unless errors.empty?
    UI.user_error!("Release JS config is incomplete:\n- #{errors.join("\n- ")}\n" \
                   "Put production values in apps/mobile/.env.production.local (git-ignored).")
  end

  app_env = env["EXPO_PUBLIC_APP_ENV"].to_s
  UI.important("EXPO_PUBLIC_APP_ENV is '#{app_env}', not 'production'") unless app_env == "production"
  UI.important("EXPO_PUBLIC_POSTHOG_KEY is not set; analytics stay off in this build") if env["EXPO_PUBLIC_POSTHOG_KEY"].to_s.strip.empty?
  UI.message("Release JS bundle will use Supabase host #{host}, app env '#{app_env}'")
end

# --- iOS helpers --------------------------------------------------------------

def ios_asc_key_path
  custom = ENV["ASC_KEY_PATH"].to_s.strip
  path = custom.empty? ? File.join("fastlane", "AuthKey_#{ENV['ASC_KEY_ID'].to_s.strip}.p8") : custom
  File.expand_path(path, APP_ROOT)
end

# App Store Connect API key from ASC_KEY_ID (+ ASC_ISSUER_ID for team keys) and
# the git-ignored .p8 file. Returns nil when no key is configured.
def ios_asc_api_key(required:)
  if ENV["ASC_KEY_ID"].to_s.strip.empty?
    UI.user_error!("Set ASC_KEY_ID (and ASC_ISSUER_ID for team keys) in fastlane/.env; see fastlane/.env.example") if required
    return nil
  end

  key_path = ios_asc_key_path
  unless File.exist?(key_path)
    UI.user_error!("App Store Connect API key not found at #{key_path}") if required
    UI.important("No App Store Connect API key at #{key_path}; signing with the Xcode account")
    return nil
  end

  issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"].strip,
    # Individual keys have no issuer ID.
    issuer_id: issuer_id.empty? ? nil : issuer_id,
    key_filepath: key_path
  )
end

# Next TestFlight build number. The latest upload for the app.json version is
# its highest build, since App Store Connect only accepts increasing numbers per
# version; the latest upload overall keeps numbers increasing across versions.
def ios_next_build_number(api_key)
  version = JSON.parse(File.read(File.join(APP_ROOT, "app.json"))).dig("expo", "version")
  latest = [version, nil].map do |filter|
    number = latest_testflight_build_number(api_key: api_key, version: filter, initial_build_number: 0)
    Integer(number.to_s, exception: false) ||
      UI.user_error!("TestFlight build number '#{number}' is not an integer; pass build_number: to `ios build` instead")
  end
  latest.max + 1
end

# Xcode automatic signing. -allowProvisioningUpdates lets xcodebuild create or
# refresh the distribution certificate and App Store profiles for the app,
# watch and widget targets. A team key authenticates that directly; otherwise
# xcodebuild uses the Apple ID signed in to Xcode (Settings -> Accounts).
# Either way the account needs the Admin role.
def ios_signing_xcargs(api_key)
  args = ["-allowProvisioningUpdates"]
  if api_key && api_key[:issuer_id]
    args += [
      "-authenticationKeyPath", ios_asc_key_path,
      "-authenticationKeyID", api_key[:key_id],
      "-authenticationKeyIssuerID", api_key[:issuer_id]
    ]
  end
  args.shelljoin
end

# The main app Info.plist carries a literal CFBundleVersion; the watch and
# widget targets derive theirs from CURRENT_PROJECT_VERSION. Update both so all
# three bundles ship the same build number, as App Store Connect requires.
# (agvtool is avoided because it rewrites the git-tracked targets/*/Info.plist.)
def ios_set_build_number(build_number)
  sh("/usr/libexec/PlistBuddy", "-c", "Set :CFBundleVersion #{build_number}",
     File.join(IOS_DIR, "Sweaty", "Info.plist"))

  pbxproj = File.join(IOS_DIR, "Sweaty.xcodeproj", "project.pbxproj")
  pattern = /CURRENT_PROJECT_VERSION = [^;]+;/
  contents = File.read(pbxproj)
  count = contents.scan(pattern).length
  UI.user_error!("No CURRENT_PROJECT_VERSION found in #{pbxproj}") if count.zero?
  File.write(pbxproj, contents.gsub(pattern, "CURRENT_PROJECT_VERSION = #{build_number};"))
  UI.success("Build number #{build_number} set in Info.plist and #{count} build configurations")
end

# Checks the exported IPA contains the watch app and widget extension, all
# with the app's build number.
def ios_verify_ipa!(ipa_path)
  app = "Payload/Sweaty.app"
  bundles = {
    "Sweaty" => "#{app}/Info.plist",
    "SweatyWatch" => "#{app}/Watch/SweatyWatch.app/Info.plist",
    "SweatyWidget" => "#{app}/PlugIns/SweatyWidget.appex/Info.plist"
  }
  versions = bundles.to_h do |name, plist|
    data, status = Open3.capture2("unzip", "-p", ipa_path, plist, binmode: true)
    UI.user_error!("#{name} is missing from #{ipa_path}") unless status.success? && !data.empty?
    version, status = Open3.capture2("plutil", "-extract", "CFBundleVersion", "raw", "-o", "-", "-",
                                     stdin_data: data, binmode: true)
    UI.user_error!("Could not read the #{name} CFBundleVersion") unless status.success?
    [name, version.strip]
  end
  if versions.values.uniq.length > 1
    UI.user_error!("Bundle build numbers differ: #{versions.map { |name, version| "#{name}=#{version}" }.join(', ')}")
  end
  UI.success("IPA contains #{versions.keys.join(', ')} with build #{versions.values.first}")
end

# --- iOS lanes ----------------------------------------------------------------

platform :ios do
  desc "Build a signed App Store IPA into build/ios without uploading it"
  desc "Options: build_number:<n> sets the build number, clean:true forces expo prebuild"
  lane :build do |options|
    build_number = options[:build_number] && Integer(options[:build_number].to_s)
    check_release_js_env!
    ios_build_ipa(api_key: ios_asc_api_key(required: false), build_number: build_number, clean: options[:clean])
  end

  desc "Build a signed IPA and upload it to TestFlight (build number = latest TestFlight build + 1)"
  desc "Options: clean:true forces expo prebuild"
  lane :beta do |options|
    api_key = ios_asc_api_key(required: true)
    check_release_js_env!
    build_number = ios_next_build_number(api_key)
    ipa = ios_build_ipa(api_key: api_key, build_number: build_number, clean: options[:clean])
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      # Processing takes 5-30 minutes; TestFlight emails testers when it's done.
      skip_waiting_for_build_processing: true
    )
    UI.success("Uploaded build #{build_number} to TestFlight")
  end

  private_lane :ios_build_ipa do |options|
    prepare_native_project(:ios, clean: options[:clean], required_paths: ["Sweaty.xcworkspace", "Pods"]) do
      Dir.chdir(IOS_DIR) { sh("bundle", "exec", "pod", "install") }
    end
    ios_set_build_number(options[:build_number]) if options[:build_number]

    ipa = build_app(
      workspace: IOS_WORKSPACE,
      scheme: IOS_SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_team_id: IOS_TEAM_ID,
      output_directory: File.join(BUILD_DIR, "ios"),
      output_name: "Sweaty.ipa",
      clean: true,
      # Passed to both archive and export.
      xcargs: ios_signing_xcargs(options[:api_key])
    )
    ios_verify_ipa!(ipa)
    ipa
  end
end
