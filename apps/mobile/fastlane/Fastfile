# Release lanes for the Sweaty Expo app. They build locally and upload
# straight to the stores, with no EAS involved.
#
# Run from apps/mobile, e.g. `npm run release:ios` or
# `bundle exec fastlane ios build`. Setup, credentials and troubleshooting:
# apps/mobile/README.md -> "Releasing with fastlane".

require "dotenv"
require "json"
require "open3"
require "uri"

# fastlane's log handling and CocoaPods both break without a UTF-8 locale.
# Ruby picks its default encoding at startup, so set it here as well as the
# environment inherited by child processes.
%w[LANG LC_ALL].each do |name|
  ENV[name] = "en_US.UTF-8" unless ENV[name].to_s.include?("UTF-8")
end
Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8

# `xcodebuild -showBuildSettings` on this workspace takes longer than
# fastlane's default 3-second timeout.
ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] ||= "30"

FASTLANE_DIR = File.expand_path(__dir__)
APP_ROOT = File.expand_path("..", FASTLANE_DIR)
BUILD_DIR = File.join(APP_ROOT, "build")

IOS_DIR = File.join(APP_ROOT, "ios")
IOS_WORKSPACE = File.join(IOS_DIR, "Sweaty.xcworkspace")
IOS_SCHEME = "Sweaty"
IOS_TEAM_ID = "X6TS5L9ZTL"
IOS_PROJECT = File.join(IOS_DIR, "Sweaty.xcodeproj")
# Signed targets of the generated project and their bundle IDs. Each one needs
# an existing App Store profile made with the team's distribution certificate.
IOS_SIGNED_TARGETS = {
  "Sweaty" => "com.ogig.sweaty",
  "SweatyWidget" => "com.ogig.sweaty.SweatyWidget",
  "SweatyWatch" => "com.ogig.sweaty.SweatyWatch"
}.freeze

# Stamp written into a generated native folder after a successful prebuild.
FINGERPRINT_STAMP = ".fastlane-fingerprint"

# Files `expo export:embed` reads for a release JS bundle, lowest priority
# first. Values already in the process environment win over all of them.
EXPO_RELEASE_ENV_FILES = %w[.env .env.production .env.local .env.production.local].freeze

default_platform(:ios)
skip_docs

before_all do
  ensure_bundle_exec
end

# --- Shared helpers ---------------------------------------------------------

# Hash of everything that shapes the generated native project: app config,
# config plugins, native dependencies and the Apple target configs. ios/ and
# android/ are git-ignored (generated), so they are not part of it.
def native_fingerprint(platform)
  script = <<~JS
    require("@expo/fingerprint")
      .createFingerprintAsync(process.cwd(), { platforms: [process.argv[1]] })
      .then((fingerprint) => console.log(fingerprint.hash))
      .catch((error) => { console.error(error); process.exit(1); });
  JS
  stdout, stderr, status = Open3.capture3("node", "-e", script, platform.to_s, chdir: APP_ROOT)
  UI.user_error!("Could not compute the native fingerprint:\n#{stderr}") unless status.success?
  stdout.strip
end

# Runs `expo prebuild` only when the native project is missing, its inputs
# changed since the last prebuild, or `clean` is set. Prebuild always uses
# --clean: incremental prebuilds crash in @bacons/apple-targets, and a fresh
# folder drops any local edits to generated files.
def prepare_native_project(platform, clean: false, required_paths: [])
  native_dir = File.join(APP_ROOT, platform.to_s)
  stamp = File.join(native_dir, FINGERPRINT_STAMP)
  fingerprint = native_fingerprint(platform)
  complete = required_paths.all? { |path| File.exist?(File.join(native_dir, path)) }

  if !clean && complete && File.exist?(stamp) && File.read(stamp).strip == fingerprint
    UI.success("#{platform}/ is up to date (fingerprint #{fingerprint[0, 12]}), skipping expo prebuild")
    return
  end

  UI.message("Regenerating #{platform}/ with expo prebuild (fingerprint #{fingerprint[0, 12]})")
  Dir.chdir(APP_ROOT) do
    # CI=1 stops prebuild from prompting about uncommitted changes.
    sh({ "CI" => "1", "EXPO_NO_GIT_STATUS" => "1" },
       "npx", "expo", "prebuild", "--platform", platform.to_s, "--clean", "--no-install")
  end
  yield if block_given?
  File.write(stamp, "#{fingerprint}\n")
end

# Fails before a long native build when the JS bundle would ship without the
# config lib/supabase.ts requires at startup. EAS used to inject these values;
# locally they come from apps/mobile/.env.production.local (git-ignored).
def check_release_js_env!
  env_files = EXPO_RELEASE_ENV_FILES.map { |name| File.join(APP_ROOT, name) }.select { |path| File.exist?(path) }
  # Dotenv would run $(...) command substitutions, which Expo's loader leaves as
  # literal text in the bundle, so reject them instead of parsing.
  env_files.each do |path|
    if File.foreach(path).any? { |line| !line.lstrip.start_with?("#") && line.include?("$(") }
      UI.user_error!("#{File.basename(path)} uses $(...) substitution, which Expo does not expand; use literal values")
    end
  end
  env = Dotenv.parse(*env_files).merge(ENV.to_h)

  url = env["EXPO_PUBLIC_SUPABASE_URL"].to_s.strip
  anon_key = env["EXPO_PUBLIC_SUPABASE_ANON_KEY"].to_s.strip
  host = begin
    URI.parse(url).host.to_s
  rescue URI::InvalidURIError
    ""
  end

  errors = []
  errors << "EXPO_PUBLIC_SUPABASE_URL is missing" if url.empty?
  errors << "EXPO_PUBLIC_SUPABASE_URL must use https://" unless url.empty? || url.start_with?("https://")
  errors << "EXPO_PUBLIC_SUPABASE_URL points at a local server" if %w[localhost 127.0.0.1].include?(host)
  errors << "EXPO_PUBLIC_SUPABASE_URL is still the .env.example placeholder" if url.include?("your-project-ref")
  errors << "EXPO_PUBLIC_SUPABASE_ANON_KEY is missing" if anon_key.empty?
  errors << "EXPO_PUBLIC_SUPABASE_ANON_KEY is still the .env.example placeholder" if anon_key.start_with?("your_")
  unless errors.empty?
    UI.user_error!("Release JS config is incomplete:\n- #{errors.join("\n- ")}\n" \
                   "Put production values in apps/mobile/.env.production.local (git-ignored).")
  end

  app_env = env["EXPO_PUBLIC_APP_ENV"].to_s
  UI.important("EXPO_PUBLIC_APP_ENV is '#{app_env}', not 'production'") unless app_env == "production"
  UI.important("EXPO_PUBLIC_POSTHOG_KEY is not set; analytics stay off in this build") if env["EXPO_PUBLIC_POSTHOG_KEY"].to_s.strip.empty?
  UI.message("Release JS bundle will use Supabase host #{host}, app env '#{app_env}'")
end

# --- iOS helpers --------------------------------------------------------------

# @bacons/apple-targets rewrites the git-tracked targets/*/Assets.xcassets
# Contents.json files without a trailing newline on every prebuild. Put the
# newline back where that is the only difference from the committed file, so a
# release leaves git clean while real color or icon changes stay visible.
def ios_restore_target_asset_newlines
  Dir.glob(File.join(APP_ROOT, "targets", "*", "Assets.xcassets", "**", "Contents.json")).each do |path|
    contents = File.read(path)
    next if contents.end_with?("\n")

    relative = path.delete_prefix("#{APP_ROOT}/")
    committed, status = Open3.capture2("git", "show", "HEAD:./#{relative}", chdir: APP_ROOT, err: File::NULL)
    File.write(path, committed) if status.success? && committed == "#{contents}\n"
  end
end

def ios_asc_key_path
  custom = ENV["ASC_KEY_PATH"].to_s.strip
  path = custom.empty? ? File.join("fastlane", "AuthKey_#{ENV['ASC_KEY_ID'].to_s.strip}.p8") : custom
  File.expand_path(path, APP_ROOT)
end

# App Store Connect API key from ASC_KEY_ID (+ ASC_ISSUER_ID for team keys) and
# the git-ignored .p8 file. Both lanes need it to download the App Store
# profiles; `ios beta` also uses it for build numbers and the upload.
def ios_asc_api_key
  if ENV["ASC_KEY_ID"].to_s.strip.empty?
    UI.user_error!("Set ASC_KEY_ID (and ASC_ISSUER_ID for team keys) in fastlane/.env; see fastlane/.env.example")
  end

  key_path = ios_asc_key_path
  UI.user_error!("App Store Connect API key not found at #{key_path}") unless File.exist?(key_path)

  issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"].strip,
    # Individual keys have no issuer ID.
    issuer_id: issuer_id.empty? ? nil : issuer_id,
    key_filepath: key_path
  )
end

# Next TestFlight build number. The latest upload for the app.json version is
# its highest build, since App Store Connect only accepts increasing numbers per
# version; the latest upload overall keeps numbers increasing across versions.
def ios_next_build_number(api_key)
  version = JSON.parse(File.read(File.join(APP_ROOT, "app.json"))).dig("expo", "version")
  latest = [version, nil].map do |filter|
    number = latest_testflight_build_number(api_key: api_key, version: filter, initial_build_number: 0)
    Integer(number.to_s, 10, exception: false) ||
      UI.user_error!("TestFlight build number '#{number}' is not an integer; pass build_number: to `ios build` instead")
  end
  latest.max + 1
end

# Signing only uses what the team already has: the existing distribution
# certificate, imported into the login keychain as a .p12, and the existing App
# Store profiles. The lanes must never create, repair or revoke certificates or
# profiles, so nothing here passes -allowProvisioningUpdates to xcodebuild.

# Keychain name of the team's distribution identity. The private key has to be
# in the keychain, and Apple never hands it out; see README -> "iOS signing".
def ios_distribution_identity!
  output, = Open3.capture2("security", "find-identity", "-v", "-p", "codesigning")
  names = output.scan(/"((?:Apple|iPhone|iOS) Distribution: [^"]*\(#{IOS_TEAM_ID}\))"/).flatten.uniq
  if names.empty?
    UI.user_error!("No distribution certificate with a private key for team #{IOS_TEAM_ID} in the keychain. " \
                   "Import the team's existing one (.p12); the lanes never create certificates. " \
                   "See README -> \"iOS signing\".")
  end
  if names.length > 1
    UI.user_error!("Several distribution identities for team #{IOS_TEAM_ID} in the keychain " \
                   "(#{names.join(', ')}); keep only the one the App Store profiles use")
  end
  names.first
end

# Downloads and installs the existing App Store profile of every signed target.
# `readonly` makes sigh fail instead of creating or regenerating a profile, and
# it only accepts profiles whose certificate is in the local keychain.
# Returns bundle ID => profile name.
def ios_app_store_profiles!(api_key)
  IOS_SIGNED_TARGETS.values.to_h do |bundle_id|
    begin
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: bundle_id,
        team_id: IOS_TEAM_ID,
        readonly: true,
        output_path: File.join(BUILD_DIR, "ios", "profiles")
      )
    rescue FastlaneCore::Interface::FastlaneError => e
      UI.user_error!("No usable App Store profile for #{bundle_id}: #{e.message}\n" \
                     "It must exist in the developer portal and use the distribution certificate in your " \
                     "keychain. The lanes never create profiles; see README -> \"iOS signing\".")
    end
    # The action returns the profile UUID; the file path is in the lane context.
    path = Fastlane::Actions.lane_context[Fastlane::Actions::SharedValues::SIGH_PROFILE_PATH]
    [bundle_id, FastlaneCore::ProvisioningProfile.name(path)]
  end
end

# Switches the Release configuration of every signed target to manual signing
# with the downloaded profiles. ios/ is generated and git-ignored.
def ios_use_manual_signing(identity, profiles)
  IOS_SIGNED_TARGETS.each do |target, bundle_id|
    update_code_signing_settings(
      path: IOS_PROJECT,
      use_automatic_signing: false,
      targets: [target],
      build_configurations: ["Release"],
      team_id: IOS_TEAM_ID,
      code_sign_identity: identity,
      profile_name: profiles.fetch(bundle_id),
      bundle_identifier: bundle_id
    )
  end
end

# The main app Info.plist carries a literal CFBundleVersion; the watch and
# widget targets derive theirs from CURRENT_PROJECT_VERSION. Update both so all
# three bundles ship the same build number, as App Store Connect requires.
# (agvtool is avoided because it rewrites the git-tracked targets/*/Info.plist.)
def ios_set_build_number(build_number)
  sh("/usr/libexec/PlistBuddy", "-c", "Set :CFBundleVersion #{build_number}",
     File.join(IOS_DIR, "Sweaty", "Info.plist"))

  pbxproj = File.join(IOS_DIR, "Sweaty.xcodeproj", "project.pbxproj")
  pattern = /CURRENT_PROJECT_VERSION = [^;]+;/
  contents = File.read(pbxproj)
  count = contents.scan(pattern).length
  UI.user_error!("No CURRENT_PROJECT_VERSION found in #{pbxproj}") if count.zero?
  File.write(pbxproj, contents.gsub(pattern, "CURRENT_PROJECT_VERSION = #{build_number};"))
  UI.success("Build number #{build_number} set in Info.plist and #{count} build configurations")
end

# Checks the exported IPA contains the watch app and widget extension, all
# with the app's build number.
def ios_verify_ipa!(ipa_path)
  app = "Payload/Sweaty.app"
  bundles = {
    "Sweaty" => "#{app}/Info.plist",
    "SweatyWatch" => "#{app}/Watch/SweatyWatch.app/Info.plist",
    "SweatyWidget" => "#{app}/PlugIns/SweatyWidget.appex/Info.plist"
  }
  versions = bundles.to_h do |name, plist|
    data, status = Open3.capture2("unzip", "-p", ipa_path, plist, binmode: true)
    UI.user_error!("#{name} is missing from #{ipa_path}") unless status.success? && !data.empty?
    version, status = Open3.capture2("plutil", "-extract", "CFBundleVersion", "raw", "-o", "-", "-",
                                     stdin_data: data, binmode: true)
    UI.user_error!("Could not read the #{name} CFBundleVersion") unless status.success?
    [name, version.strip]
  end
  if versions.values.uniq.length > 1
    UI.user_error!("Bundle build numbers differ: #{versions.map { |name, version| "#{name}=#{version}" }.join(', ')}")
  end
  UI.success("IPA contains #{versions.keys.join(', ')} with build #{versions.values.first}")
end

# --- iOS lanes ----------------------------------------------------------------

platform :ios do
  desc "Build a signed App Store IPA into build/ios without uploading it"
  desc "Options: build_number:<n> sets the build number, clean:true forces expo prebuild"
  lane :build do |options|
    build_number = options[:build_number] && Integer(options[:build_number].to_s, 10)
    check_release_js_env!
    ios_build_ipa(api_key: ios_asc_api_key, build_number: build_number, clean: options[:clean])
  end

  desc "Build a signed IPA and upload it to TestFlight (build number = latest TestFlight build + 1)"
  desc "Options: clean:true forces expo prebuild"
  lane :beta do |options|
    api_key = ios_asc_api_key
    check_release_js_env!
    build_number = ios_next_build_number(api_key)
    ipa = ios_build_ipa(api_key: api_key, build_number: build_number, clean: options[:clean])
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      # Processing takes 5-30 minutes; TestFlight emails testers when it's done.
      skip_waiting_for_build_processing: true
    )
    UI.success("Uploaded build #{build_number} to TestFlight")
  end

  private_lane :ios_build_ipa do |options|
    # Check signing before the long native steps.
    identity = ios_distribution_identity!
    profiles = ios_app_store_profiles!(options[:api_key])

    prepare_native_project(:ios, clean: options[:clean], required_paths: ["Sweaty.xcworkspace", "Pods"]) do
      ios_restore_target_asset_newlines
      Dir.chdir(IOS_DIR) { sh("bundle", "exec", "pod", "install") }
    end
    ios_set_build_number(options[:build_number]) if options[:build_number]
    ios_use_manual_signing(identity, profiles)

    ipa = build_app(
      workspace: IOS_WORKSPACE,
      scheme: IOS_SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_team_id: IOS_TEAM_ID,
      # Profiles for the export; gym switches the export to manual signing.
      export_options: { provisioningProfiles: profiles },
      output_directory: File.join(BUILD_DIR, "ios"),
      output_name: "Sweaty.ipa",
      clean: true
    )
    ios_verify_ipa!(ipa)
    ipa
  end
end

# --- Android helpers ------------------------------------------------------------
#
# Ready but not in regular use yet. To release, plug in:
# - the upload key: fastlane/keystore.properties (from keystore.properties.example)
#   or SWEATY_UPLOAD_* env vars;
# - the Play service account key: fastlane/google-play-service-account.json
#   or PLAY_JSON_KEY_PATH;
# - PLAY_RELEASE_STATUS=completed after the first release made by hand.
# Full steps: apps/mobile/README.md -> "Android setup" / "First Google Play release".

ANDROID_DIR = File.join(APP_ROOT, "android")
ANDROID_PACKAGE = "com.ogig.sweaty"

# Upload key sources, mirrored from plugins/with-android-release-signing.cjs:
# each SWEATY_UPLOAD_* env var wins over its fastlane/keystore.properties key.
ANDROID_UPLOAD_KEY_FIELDS = {
  "SWEATY_UPLOAD_STORE_FILE" => "storeFile",
  "SWEATY_UPLOAD_STORE_PASSWORD" => "storePassword",
  "SWEATY_UPLOAD_KEY_ALIAS" => "keyAlias",
  "SWEATY_UPLOAD_KEY_PASSWORD" => "keyPassword"
}.freeze

# .properties reader matching java.util.Properties for single-line entries:
# `=`, `:` or whitespace separators, # and ! comments, backslash escapes.
def read_java_properties(path)
  unescape = lambda do |text|
    text.gsub(/\\(.)/) { { "t" => "\t", "n" => "\n", "r" => "\r", "f" => "\f" }.fetch(Regexp.last_match(1), Regexp.last_match(1)) }
  end
  File.readlines(path, chomp: true).each_with_object({}) do |line, props|
    line = line.lstrip
    next if line.empty? || line.start_with?("#", "!")

    key, value = line.match(/\A((?:\\.|[^\s=:\\])*)\s*[=:]?\s*(.*)\z/).captures
    props[unescape.call(key)] = unescape.call(value)
  end
end

# Release AABs must be signed with the Play upload key. Gradle quietly falls
# back to the debug key when nothing is configured, so check before building.
def android_check_upload_key!
  props_file = File.join(FASTLANE_DIR, "keystore.properties")
  props = File.exist?(props_file) ? read_java_properties(props_file) : {}
  values = ANDROID_UPLOAD_KEY_FIELDS.to_h do |env_name, prop|
    from_env = ENV[env_name].to_s.strip
    [prop, from_env.empty? ? props[prop].to_s.strip : from_env]
  end

  missing = values.select { |_, value| value.empty? }.keys
  unless missing.empty?
    UI.user_error!("Android upload key is not configured (missing #{missing.join(', ')}). " \
                   "Copy fastlane/keystore.properties.example to fastlane/keystore.properties " \
                   "or set SWEATY_UPLOAD_*; see README -> Releasing with fastlane.")
  end
  keystore = File.expand_path(values["storeFile"], FASTLANE_DIR)
  UI.user_error!("Android upload keystore not found at #{keystore}") unless File.exist?(keystore)
end

def java_major_version(java_home)
  release = File.join(java_home.to_s, "release")
  return nil unless File.exist?(release)

  File.read(release)[/^JAVA_VERSION="(\d+)/, 1]&.to_i
end

# React Native 0.81's Gradle build needs JDK 17. Picks it up from
# /usr/libexec/java_home when JAVA_HOME points elsewhere, and defaults
# ANDROID_HOME to Android Studio's SDK location.
def android_prepare_toolchain!
  unless java_major_version(ENV["JAVA_HOME"]) == 17
    jdk17, status = Open3.capture2("/usr/libexec/java_home", "-v", "17", err: File::NULL)
    jdk17 = jdk17.strip
    unless status.success? && java_major_version(jdk17) == 17
      UI.user_error!("Android builds need JDK 17 (brew install openjdk@17), then point JAVA_HOME at it")
    end
    UI.important("Using JDK 17 at #{jdk17} (JAVA_HOME was #{ENV['JAVA_HOME'] || 'unset'})")
    ENV["JAVA_HOME"] = jdk17
  end

  return unless ENV["ANDROID_HOME"].to_s.strip.empty?

  sdk = File.expand_path("~/Library/Android/sdk")
  UI.user_error!("Set ANDROID_HOME to the Android SDK directory") unless File.directory?(sdk)
  UI.message("Using the Android SDK at #{sdk}")
  ENV["ANDROID_HOME"] = sdk
end

def android_play_json_key!
  custom = ENV["PLAY_JSON_KEY_PATH"].to_s.strip
  path = File.expand_path(custom.empty? ? File.join("fastlane", "google-play-service-account.json") : custom, APP_ROOT)
  unless File.exist?(path)
    UI.user_error!("Google Play service account key not found at #{path}; see README -> Releasing with fastlane")
  end
  path
end

# versionCode must be unique across every Play track, so take the highest one.
# A single read-only edit lists all tracks, including closed testing ones.
def android_next_version_code(json_key)
  require "supply"
  client = Supply::Client.make_from_config(params: { json_key: json_key, timeout: 300 })
  client.begin_edit(package_name: ANDROID_PACKAGE)
  codes = client.tracks.flat_map do |track|
    (track.releases || []).flat_map { |release| release.version_codes || [] }
  end
  client.abort_current_edit
  (codes.map(&:to_i).max || 0) + 1
rescue OpenSSL::PKey::PKeyError => e
  UI.user_error!("#{json_key} is not a valid Google service account key (#{e.message})")
rescue FastlaneCore::Interface::FastlaneError => e
  UI.user_error!("Could not read version codes from Google Play: #{e.message}\n" \
                 "If #{ANDROID_PACKAGE} has no release yet, upload the first AAB by hand " \
                 "(bundle exec fastlane android build version_code:1).")
end

# Fails when the bundle carries the debug certificate instead of the upload key.
def android_verify_aab!(aab_path)
  keytool = File.join(ENV.fetch("JAVA_HOME"), "bin", "keytool")
  output, status = Open3.capture2e(keytool, "-printcert", "-jarfile", aab_path)
  UI.user_error!("Could not read the signature of #{aab_path}:\n#{output}") unless status.success?
  owner = output[/^Owner: (.*)$/, 1]
  UI.user_error!("#{aab_path} is not signed:\n#{output}") unless owner
  UI.user_error!("#{aab_path} is signed with the debug key") if owner.include?("CN=Android Debug")
  UI.success("AAB signed by #{owner}")
end

# --- Android lanes ----------------------------------------------------------------

platform :android do
  desc "Build a signed release AAB into android/app/build/outputs/bundle/release without uploading it"
  desc "Options: version_code:<n> sets versionCode, clean:true forces expo prebuild"
  lane :build do |options|
    version_code = options[:version_code] && Integer(options[:version_code].to_s, 10)
    android_check_upload_key!
    check_release_js_env!
    android_build_aab(version_code: version_code, clean: options[:clean])
  end

  desc "Build a signed AAB and upload it to the Play internal testing track (versionCode = highest on Play + 1)"
  desc "Options: clean:true forces expo prebuild"
  lane :beta do |options|
    json_key = android_play_json_key!
    android_check_upload_key!
    android_prepare_toolchain!
    check_release_js_env!
    version_code = android_next_version_code(json_key)
    aab = android_build_aab(version_code: version_code, clean: options[:clean])
    release_status = ENV["PLAY_RELEASE_STATUS"].to_s.strip
    upload_to_play_store(
      package_name: ANDROID_PACKAGE,
      json_key: json_key,
      track: "internal",
      aab: aab,
      # Play only accepts drafts until the app has its first release.
      release_status: release_status.empty? ? "draft" : release_status,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
    UI.success("Uploaded versionCode #{version_code} to the internal testing track")
  end

  private_lane :android_build_aab do |options|
    android_prepare_toolchain!
    prepare_native_project(:android, clean: options[:clean], required_paths: ["gradlew"])

    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: ANDROID_DIR,
      # Read by plugins/with-android-release-signing.cjs.
      properties: options[:version_code] ? { "sweaty.versionCode" => options[:version_code] } : {}
    )
    aab = lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]
    UI.user_error!("Gradle did not produce an AAB") unless aab && File.exist?(aab)
    android_verify_aab!(aab)
    aab
  end
end
