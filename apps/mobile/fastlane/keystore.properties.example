# Copy to fastlane/keystore.properties (git-ignored) and fill in the Google Play
# upload key. plugins/with-android-release-signing.cjs reads it for release
# builds; SWEATY_UPLOAD_* env vars override each value.
#
# Relative storeFile paths resolve from apps/mobile/fastlane/. Keep the
# keystore itself next to this file (*.keystore and *.jks are git-ignored) and
# back it up outside the repository: Play only accepts builds signed with it.

storeFile=sweaty-upload.keystore
storePassword=
keyAlias=upload
keyPassword=
